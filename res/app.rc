#include <winver.h>
#include "../build/version.h"

// App icon by nik-txt (app.svg, made by make_icon.py): white for the exe and dark themes, black for light ones.
1 ICON "app.ico"
2 ICON "app_light.ico"
1 24 "app.manifest"
FLAG_RU BITMAP "flag_ru.bmp"  // Russian flag next to Русский in the Language menu (PR #1754)
// The other languages' flags, drawn by make_flags.py. Name: FLAG_<language code>, "-" as "_".
FLAG_EN BITMAP "flag_en.bmp"
FLAG_DE BITMAP "flag_de.bmp"
FLAG_ES BITMAP "flag_es.bmp"
FLAG_FR BITMAP "flag_fr.bmp"
FLAG_IT_IT BITMAP "flag_it_it.bmp"
FLAG_HU BITMAP "flag_hu.bmp"
FLAG_PL BITMAP "flag_pl.bmp"
FLAG_PT_BR BITMAP "flag_pt_br.bmp"
FLAG_SV BITMAP "flag_sv.bmp"
FLAG_VI BITMAP "flag_vi.bmp"
FLAG_TR BITMAP "flag_tr.bmp"
FLAG_UK BITMAP "flag_uk.bmp"
FLAG_HE BITMAP "flag_he.bmp"
FLAG_AR BITMAP "flag_ar.bmp"
FLAG_FA BITMAP "flag_fa.bmp"
FLAG_TH BITMAP "flag_th.bmp"
FLAG_JA BITMAP "flag_ja.bmp"
FLAG_ZH_CN BITMAP "flag_zh_cn.bmp"
FLAG_ZH_TW BITMAP "flag_zh_tw.bmp"
FLAG_KO BITMAP "flag_ko.bmp"

// The built-in UI languages: lang\*.txt joined by the build (see src/i18n.cpp).
LANGS RCDATA "languages.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION WB_VERSION_RESOURCE
PRODUCTVERSION WB_VERSION_RESOURCE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "BatteryHub"
      VALUE "ProductName", "BatteryHub"
      VALUE "FileVersion", WB_VERSION_STRING
      VALUE "ProductVersion", WB_VERSION_STRING
      VALUE "OriginalFilename", "BatteryHub.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
